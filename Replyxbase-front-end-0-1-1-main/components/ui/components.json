  "designSystem": {
    "colors": {
      "primary": "#005bbc",
      "primaryDark": "#004a9f",
      "accent": "#ffd600",
      "slate": {
        "50": "bg-slate-50",
        "200": "border-slate-200",
        "600": "text-slate-600",
        "700": "text-slate-700",
        "800": "text-slate-800",
        "900": "text-slate-900"
      }
    },
    "spacing": {
      "padding": {
        "sm": "p-4",
        "md": "p-6",
        "lg": "p-8"
      },
      "margin": {
        "sm": "m-4",
        "md": "m-6",
        "lg": "m-8"
      }
    },
    "borders": {
      "standard": "border-2 border-slate-200",
      "primary": "border-2 border-[#005bbc]/20",
      "accent": "border-2 border-[#ffd600]/20"
    },
    "radius": {
      "sm": "rounded-lg",
      "md": "rounded-xl",
      "lg": "rounded-2xl",
      "full": "rounded-full"
    },
    "rules": [
      "Always use border-2 for borders (never border or border-1)",
      "No shadows - use borders instead",
      "Primary color: #005bbc for main actions",
      "Accent color: #ffd600 for highlights",
      "Use slate color palette for text and backgrounds",
      "Consistent padding: p-4, p-6, p-8",
      "Rounded corners: rounded-xl or rounded-2xl"
    ]
  }
}
